<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!--
        Embedded libraries. Every one of them is optional as far as this addon's
        own code goes: each place that uses one asks LibStub first and works
        without it. They are shipped so that the features built on them work for
        everybody, not only for players who happen to have another addon that
        loads the same library.

        LibStub makes this safe next to other addons: when a newer copy of a
        library is already loaded, the newer one wins and this copy is skipped.

            LibStub, CallbackHandler-1.0   plumbing the others need
            LibDataBroker-1.1              data source for Titan Panel, ChocolateBar, ...
            LibDBIcon-1.0                  the shared minimap button (Settings > Interface)
            LibSharedMedia-3.0             fonts registered by other addons (Settings > Appearance)
            LibDeflate, LibSerialize       compact export strings (/wtm export)

        Ace3 is NOT shipped. Core/Ace.lua uses it when another addon provides
        it and has its own implementation otherwise:

            AceAddon-3.0, AceEvent-3.0, AceConsole-3.0, AceDB-3.0, AceTimer-3.0
    -->
    <Script file="LibStub\LibStub.lua"/>
    <Script file="CallbackHandler-1.0\CallbackHandler-1.0.lua"/>
    <Script file="LibDataBroker-1.1\LibDataBroker-1.1.lua"/>
    <Script file="LibSharedMedia-3.0\LibSharedMedia-3.0.lua"/>
    <Script file="LibDBIcon-1.0\LibDBIcon-1.0.lua"/>
    <Script file="LibDeflate\LibDeflate.lua"/>
    <Script file="LibSerialize\LibSerialize.lua"/>
</Ui>
