<Bindings>
	<Binding name="MACROMAKER_TOGGLE" category="BINDING_HEADER_MACROMAKER">
		if MacroMaker then MacroMaker:ToggleUI() end
	</Binding>
	<Binding name="MACROMAKER_SAVE" category="BINDING_HEADER_MACROMAKER">
		if MacroMaker then MacroMaker:SaveMacro() end
	</Binding>
	<Binding name="MACROMAKER_NEW" category="BINDING_HEADER_MACROMAKER">
		if MacroMaker then MacroMaker:ClearBuilder() end
	</Binding>
	<Binding name="MACROMAKER_DUPLICATE" category="BINDING_HEADER_MACROMAKER">
		if MacroMaker then MacroMaker:DuplicateMacro() end
	</Binding>
	<Binding name="MACROMAKER_UNDO" category="BINDING_HEADER_MACROMAKER">
		if MacroMaker and MacroMaker.History then MacroMaker.History:Undo() end
	</Binding>
	<Binding name="MACROMAKER_REDO" category="BINDING_HEADER_MACROMAKER">
		if MacroMaker and MacroMaker.History then MacroMaker.History:Redo() end
	</Binding>
</Bindings>

